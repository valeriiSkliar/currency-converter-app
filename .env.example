# Copy to .env.development or .env.production and fill in values

# App environment (development | preview | production)
EXPO_PUBLIC_APP_ENV=development

# API endpoint (dev: http://localhost:8088 | prod: https://api.domain.com)
EXPO_PUBLIC_API_URL=http://localhost:8088

# Service key for API authentication (X-App-Key header)
EXPO_PUBLIC_APP_SERVICE_KEY=

# Expo account username (expo.dev) — used in app.config.ts
EXPO_ACCOUNT_OWNER=valeriiskliarov

# EAS project ID — obtain by running: pnpm dlx eas-cli init
EAS_PROJECT_ID=

# External Application URLs
EXPO_PUBLIC_SHARE_URL=https://currencyconverterapp.com
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://currencyconverterapp.com/privacy-policy
EXPO_PUBLIC_RATE_URL_IOS=https://apps.apple.com/app/currency-converter
EXPO_PUBLIC_RATE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.cimmetria.currencyconverter

# Feature flags
EXPO_PUBLIC_ENABLE_EXCHANGE_RATES=false

# AdMob Credentials
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID_IOS=
