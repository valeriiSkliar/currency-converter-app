# Copy to .env.development or .env.production and fill in values

# App environment (development | preview | production)
EXPO_PUBLIC_APP_ENV=development

# API endpoint (dev: http://localhost:8088 | prod: https://api.domain.com)
EXPO_PUBLIC_API_URL=http://localhost:8088

# Service key for API authentication (X-App-Key header)
EXPO_PUBLIC_APP_SERVICE_KEY=

# Expo account username (expo.dev) — used in app.config.ts
EXPO_ACCOUNT_OWNER=valeriiskliarov

# EAS project ID — obtain by running: pnpm dlx eas-cli init
EAS_PROJECT_ID=
